rules_version = '2';

// Règles de sécurité Storage — Harambee.
// Images uniquement, 5 Mo maximum.
service firebase.storage {
  match /b/{bucket}/o {

    function imageValide() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function commerce(commerceId) {
      return firestore.get(/databases/(default)/documents/commerces/$(commerceId)).data;
    }

    // Photos d'un commerce et de ses produits.
    match /commerces/{commerceId}/{fichier=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && commerce(commerceId).proprietaire == request.auth.uid
        && imageValide();
      allow delete: if request.auth != null
        && commerce(commerceId).proprietaire == request.auth.uid;
    }

    // Photo de profil.
    match /users/{uid}/{fichier=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && imageValide();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Photos envoyées dans une conversation.
    match /conversations/{conversationId}/{fichier=**} {
      function estParticipant() {
        return request.auth != null && request.auth.uid in
          firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
      }
      allow read: if estParticipant();
      allow create: if estParticipant() && imageValide();
    }

    match /{autre=**} {
      allow read, write: if false;
    }
  }
}
