{
  "name": "harambee-firebase",
  "private": true,
  "description": "Règles de sécurité Firebase et leurs tests (émulateur)",
  "type": "module",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project demo-harambee \"node --test --test-concurrency=1 tests/*.test.js\"",
    "test:direct": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0"
  }
}
